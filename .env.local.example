# ── Access (TEMPORARY until real auth) ───────────────────────────────────────
# Long shared token. Open the site once as https://<site>/?token=<ACCESS_TOKEN>;
# a 30-day cookie is set. Required in production (site returns 503 without it).
# Generate: openssl rand -hex 32
ACCESS_TOKEN=

# ── ClickUp (roadmap + requests) ─────────────────────────────────────────────
# Personal API token: ClickUp → Settings → Apps → API Token (starts with pk_)
CLICKUP_API_TOKEN=pk_your_token_here

# Every list in this folder is on the roadmap ("Ecommerce 26-27" in the WEB space)
CLICKUP_FOLDER_ID=90117034313
# …or pick lists explicitly instead (comma-separated). Overrides the folder.
# CLICKUP_LIST_IDS=901111926996,901112668495,901115397276,901114385176

# Where "+ Add" creates tasks (Site Backlog) and where requests land (Idea Parking Lot)
CLICKUP_DEFAULT_LIST_ID=901111926996
CLICKUP_REQUEST_LIST_ID=901114385176

# Workspace ID — only used to build links to lists
CLICKUP_TEAM_ID=18042215

# Optional
# ROADMAP_TIMEZONE=America/New_York
# CLICKUP_REQUEST_TAG=roadmap-request
# Field-name overrides (comma-separated alternatives; emoji/case ignored)
# CLICKUP_FIELD_ROADMAP_START=Roadmap Start Date
# CLICKUP_FIELD_ROADMAP_END=Roadmap End Date
# CLICKUP_FIELD_ROADMAP_MONTH=Target Month
# CLICKUP_FIELD_PILLAR=Pillar
# CLICKUP_FIELD_SPRINT=Sprint
# CLICKUP_FIELD_BIG_SWING=Big Swing

# Local development without ClickUp: built-in sample data
# CLICKUP_MOCK=1

# ── Approvals ────────────────────────────────────────────────────────────────
APPROVER_PASSWORD=your-password-here

# ── Accomplishments page (still Google Sheets) ───────────────────────────────
# Service account JSON key as a single line; needs Editor access on the sheet
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_ACCOMPLISHMENTS_SHEET_ID=1KIeteYhzmalB8ykEnU_i3UtuQxj31nvIxaTvoE9tl9U
GOOGLE_ACCOMPLISHMENTS_SHEET_NAME=
